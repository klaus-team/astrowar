FROM rust:1.88-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
RUN cargo build --release -p astrowar-server

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/astrowar-server /usr/local/bin/astrowar-server
ENV ASTROWAR_SERVER_HOST=0.0.0.0
ENV ASTROWAR_SERVER_PORT=8080
EXPOSE ${ASTROWAR_SERVER_PORT}
USER nobody
CMD ["astrowar-server"]
